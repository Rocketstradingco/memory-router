# Required: an OpenRouter API key (https://openrouter.ai/keys). Jev is billed through it.
OPENROUTER_API_KEY=sk-or-your-key-here

# Optional: where the ports are published on the host (defaults shown).
# 127.0.0.1 = reachable from this machine only. Set BIND_ADDR to this machine's LAN IP
# so agents on other machines can reach it. There is no authentication -- only expose
# it on a network you trust.
#BIND_ADDR=127.0.0.1
#ROUTER_PORT=8130
#MCP_PORT=8131
#MCP_HEALTH_PORT=8132
